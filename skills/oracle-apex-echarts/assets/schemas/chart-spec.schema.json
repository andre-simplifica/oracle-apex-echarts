{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/andre-simplifica/oracle-apex-echarts/raw/main/schemas/chart-spec.schema.json",
  "title": "Oracle APEX ECharts ChartSpec",
  "description": "Contrato inerte compartilhado pelo plugin APEX e por gráficos incorporados em Dynamic Content.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "requiredRuntime", "accessibility", "data"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "id": { "$ref": "#/$defs/id" },
    "generatedBy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "packageVersion": { "$ref": "#/$defs/semver" },
        "pluginVersion": { "$ref": "#/$defs/semver" }
      }
    },
    "requiredRuntime": {
      "type": "string",
      "const": ">=1.0.0 <2.0.0"
    },
    "theme": { "$ref": "#/$defs/token" },
    "renderer": { "enum": ["canvas", "svg"] },
    "preset": {
      "enum": [
        "bar_vertical",
        "bar_horizontal",
        "bar_stacked",
        "line",
        "area",
        "bar_line",
        "pie",
        "donut",
        "gauge",
        "scatter",
        "advanced"
      ]
    },
    "size": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "minHeight": { "type": "integer", "minimum": 180, "maximum": 1600 }
      }
    },
    "accessibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["description", "fallbackText"],
      "properties": {
        "description": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "fallbackText": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "emptyText": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "essential": { "type": "boolean" },
        "decal": { "type": "boolean" }
      }
    },
    "behavior": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "animation": { "type": "boolean" },
        "animationDuration": { "type": "integer", "minimum": 0, "maximum": 10000 },
        "download": { "type": "boolean" },
        "downloadFileName": { "$ref": "#/$defs/fileName" },
        "zoom": { "type": "boolean" },
        "legend": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "show": { "type": "boolean" },
            "position": { "enum": ["auto", "top", "bottom", "left", "right"] }
          }
        },
        "labels": { "enum": ["auto", "show", "hide"] },
        "tooltip": { "type": "boolean" },
        "aria": { "type": "boolean" },
        "formatter": {
          "enum": ["integer", "decimal_2", "percent", "currency_brl", "short_number", "date_br", "datetime_br"]
        },
        "clickEvent": { "type": "boolean" },
        "selectionEvent": { "type": "boolean" },
        "restore": { "type": "boolean" },
        "magicType": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "uniqueItems": true,
          "items": { "enum": ["line", "bar", "stack", "tiled"] }
        },
        "refreshStrategy": { "enum": ["replace", "merge"] }
      }
    },
    "integration": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "regionId": { "$ref": "#/$defs/apexIdentifier" },
        "ajaxIdentifier": { "type": "string", "minLength": 1, "maxLength": 4000 },
        "itemsToSubmit": {
          "type": "array",
          "maxItems": 100,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/pageItem" }
        },
        "responseGroup": { "$ref": "#/$defs/token" }
      }
    },
    "data": {
      "oneOf": [
        { "$ref": "#/$defs/inlineData" },
        { "$ref": "#/$defs/ajaxData" }
      ]
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,79}$"
    },
    "token": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,63}$"
    },
    "semver": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"
    },
    "fileName": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,80}$"
    },
    "apexIdentifier": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_:-]{0,254}$"
    },
    "pageItem": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]{0,254}$"
    },
    "inlineData": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "contract", "option"],
      "properties": {
        "mode": { "const": "inline" },
        "contract": { "const": "option" },
        "option": { "type": "object" }
      }
    },
    "ajaxData": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "contract", "ajax"],
      "properties": {
        "mode": { "const": "ajax" },
        "contract": { "const": "option" },
        "ajax": {
          "type": "object",
          "additionalProperties": false,
          "required": ["transport"],
          "properties": {
            "transport": { "enum": ["apexPlugin", "apexProcess"] },
            "processStaticId": { "$ref": "#/$defs/apexIdentifier" },
            "itemsToSubmit": {
              "type": "array",
              "maxItems": 100,
              "uniqueItems": true,
              "items": { "$ref": "#/$defs/pageItem" }
            },
            "responseGroup": { "$ref": "#/$defs/token" }
          },
          "allOf": [
            {
              "if": { "properties": { "transport": { "const": "apexProcess" } } },
              "then": {
                "properties": { "processStaticId": { "$ref": "#/$defs/apexIdentifier" } },
                "required": ["processStaticId"]
              },
              "else": { "properties": { "processStaticId": false } }
            }
          ]
        }
      }
    }
  }
}
