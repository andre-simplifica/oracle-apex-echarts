{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/andre-simplifica/oracle-apex-echarts/raw/main/schemas/compatibility.schema.json",
  "title": "Oracle APEX ECharts compatibility matrix",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "project", "skill", "plugin", "package", "runtime", "echarts", "chartSpec", "profile", "filesVersion", "oracleApex", "oracleDatabase", "browsers"],
  "properties": {
    "$schema": {"type": "string"},
    "schemaVersion": {"const": "1.0"},
    "project": {"$ref": "#/$defs/semver"},
    "skill": {"$ref": "#/$defs/semver"},
    "plugin": {"$ref": "#/$defs/semver"},
    "package": {"$ref": "#/$defs/semver"},
    "runtime": {"$ref": "#/$defs/semver"},
    "echarts": {"$ref": "#/$defs/semver"},
    "chartSpec": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+$"},
    "profile": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+$"},
    "filesVersion": {"type": "integer", "minimum": 1},
    "oracleApex": {"$ref": "#/$defs/platform"},
    "oracleDatabase": {"$ref": "#/$defs/platform"},
    "browsers": {
      "type": "object",
      "additionalProperties": false,
      "required": ["supported", "runtimeValidated"],
      "properties": {
        "supported": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "runtimeValidated": {"type": "array", "items": {"type": "string"}}
      }
    }
  },
  "$defs": {
    "semver": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "platform": {
      "type": "object",
      "additionalProperties": false,
      "required": ["supported", "repositoryValidated", "runtimeValidated"],
      "properties": {
        "supported": {"type": "string", "minLength": 1},
        "repositoryValidated": {"type": "string", "minLength": 1},
        "runtimeValidated": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
