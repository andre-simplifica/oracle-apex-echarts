{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/andre-simplifica/oracle-apex-echarts/raw/main/schemas/project-profile.schema.json",
  "title": "Oracle APEX ECharts project profile",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "project", "visual", "charts", "integration", "behavior", "responsive", "limits", "messages"],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "locale", "timeZone"],
      "properties": {
        "name": {"type": "string", "minLength": 1, "maxLength": 120},
        "locale": {"type": "string", "pattern": "^[a-z]{2}(?:-[A-Z]{2})?$"},
        "timeZone": {"type": "string", "pattern": "^(?:UTC|[A-Za-z_]+(?:/[A-Za-z_+-]+)+)$"}
      }
    },
    "visual": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "fallback", "overrides"],
      "properties": {
        "provider": {"enum": ["auto", "oracle-apex-brand-report-kit", "neutral"]},
        "brandReportKit": {
          "type": "object",
          "additionalProperties": false,
          "required": ["profilePath"],
          "properties": {"profilePath": {"type": "string", "minLength": 1, "maxLength": 500}}
        },
        "fallback": {"const": "neutral"},
        "overrides": {"$ref": "#/$defs/visualTokens"},
        "resolvedTokens": {"$ref": "#/$defs/visualTokens", "readOnly": true},
        "source": {"enum": ["project-overrides", "oracle-apex-brand-report-kit", "neutral"], "readOnly": true}
      }
    },
    "charts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["preferredType", "preferencePolicy", "allowedTypes"],
      "properties": {
        "preferredType": {"$ref": "#/$defs/chartType"},
        "preferencePolicy": {"enum": ["prefer", "require"]},
        "allowedTypes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/chartType"}}
      }
    },
    "integration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["defaultMode"],
      "properties": {"defaultMode": {"enum": ["plugin", "dynamic-content", "auto", "mixed"]}}
    },
    "behavior": {
      "type": "object",
      "additionalProperties": false,
      "required": ["renderer", "downloadPolicy", "animation", "labels", "legendPosition"],
      "properties": {
        "renderer": {"enum": ["canvas", "svg"]},
        "downloadPolicy": {"enum": ["never", "allow", "always"]},
        "animation": {"enum": ["auto", "always", "never"]},
        "labels": {"enum": ["auto", "show", "hide"]},
        "legendPosition": {"enum": ["auto", "top", "bottom", "left", "right"]}
      }
    },
    "responsive": {
      "type": "object",
      "additionalProperties": false,
      "required": ["breakpoints", "minHeight"],
      "properties": {
        "breakpoints": {"type": "array", "minItems": 1, "maxItems": 12, "uniqueItems": true, "items": {"type": "integer", "minimum": 280, "maximum": 4096}},
        "minHeight": {"type": "integer", "minimum": 180, "maximum": 1600},
        "hideLegendBelow": {"type": "integer", "minimum": 0, "maximum": 4096}
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["inlinePayloadWarningBytes", "pointsWarning", "maxPayloadBytes", "maxOptionDepth", "maxOptionKeys"],
      "properties": {
        "inlinePayloadWarningBytes": {"type": "integer", "minimum": 1024},
        "pointsWarning": {"type": "integer", "minimum": 100},
        "maxPayloadBytes": {"type": "integer", "minimum": 4096, "maximum": 16777216},
        "maxOptionDepth": {"type": "integer", "minimum": 4, "maximum": 32},
        "maxOptionKeys": {"type": "integer", "minimum": 20, "maximum": 10000}
      }
    },
    "messages": {
      "type": "object",
      "additionalProperties": false,
      "required": ["empty", "error"],
      "properties": {
        "empty": {"type": "string", "minLength": 1, "maxLength": 1000},
        "error": {"type": "string", "minLength": 1, "maxLength": 1000}
      }
    }
  },
  "$defs": {
    "chartType": {"enum": ["bar", "line", "area", "combo", "pie", "donut", "gauge", "scatter"]},
    "color": {"type": ["string", "null"], "pattern": "^(?:#[0-9A-Fa-f]{6}|transparent)$"},
    "visualTokens": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "palette": {"type": "array", "maxItems": 32, "items": {"type": "string", "pattern": "^#[0-9A-Fa-f]{6}$"}},
        "fontFamily": {"type": ["string", "null"], "maxLength": 240},
        "background": {"$ref": "#/$defs/color"},
        "surface": {"$ref": "#/$defs/color"},
        "textColor": {"$ref": "#/$defs/color"},
        "mutedColor": {"$ref": "#/$defs/color"},
        "lineColor": {"$ref": "#/$defs/color"},
        "borderColor": {"$ref": "#/$defs/color"},
        "breakpoints": {"type": "array", "maxItems": 12, "uniqueItems": true, "items": {"type": "integer", "minimum": 280, "maximum": 4096}},
        "reducedMotion": {"type": ["boolean", "null"]},
        "minimumContrast": {"type": ["number", "null"], "minimum": 3, "maximum": 21}
      }
    }
  }
}
